{
  "name": "northstar-systems-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-with-diagnostics.mjs dev next dev",
    "dev:raw": "next dev",
    "build": "node scripts/run-with-diagnostics.mjs build next build",
    "build:raw": "next build",
    "vercel-build": "next build",
    "start": "node scripts/run-with-diagnostics.mjs start next start",
    "start:raw": "next start",
    "test": "node scripts/run-with-diagnostics.mjs test npm run test:raw",
    "test:raw": "npm run vercel-build && npm run test:unit && npm run test:rendered:next",
    "test:unit": "node --experimental-strip-types --test tests/contact-protection.test.mjs tests/chat-protection.test.mjs tests/release-integrity.test.mjs tests/request-failure-classification.test.mjs",
    "test:rendered:next": "node scripts/verify-next-rendered.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "typecheck:release": "tsc -p tsconfig.release.json --noEmit",
    "release:prepare": "node scripts/create-release-export.mjs --verify",
    "lint": "node scripts/run-with-diagnostics.mjs lint eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .diagnostics",
    "lint:raw": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .diagnostics"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "^16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "^6.17.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "axe-core": "^4.12.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
